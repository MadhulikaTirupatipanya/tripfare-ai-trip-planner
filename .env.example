# These endpoints must accept GET query parameters:
# origin, destination, date, adults
# and return JSON: {"offers":[{"provider":"...","name":"...","departure":"...","arrival":"...","price":1200,"currency":"INR","booking_url":"https://..."}]}
TRAIN_API_URL=
TRAIN_API_KEY=
BUS_API_URL=
BUS_API_KEY=
